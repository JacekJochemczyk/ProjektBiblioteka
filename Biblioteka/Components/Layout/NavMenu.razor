@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Biblioteka</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="books">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Books
            </NavLink>
        </div>

        <AuthorizeView Roles="Employee">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/reservations">
                    Rezerwacje (pracownik)
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/books-report">
                    Raport książek
                </NavLink>
            </div>
        </AuthorizeView>


        <AuthorizeView Roles="User">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-reservations">
                    Moje rezerwacje
                </NavLink>
            </div>
        </AuthorizeView>


        @* DYNAMICZNA CZĘŚĆ – zależna od zalogowania *@
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="nav-item px-3">
                    <span class="nav-link disabled">
                        Zalogowany jako @auth.User.Identity?.Name
                    </span>
                </div>
                <div class="nav-item px-3">
                    <form method="post" action="/auth/logout" class="m-0">
                        <button type="submit" class="nav-link btn btn-link p-0">
                            Wyloguj
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        Logowanie
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        Rejestracja
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>
